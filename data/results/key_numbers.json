  "findings": [
    {
      "id": "take",
      "en": "In 2026-08, Uber's gross take rate was 21.8% ($5.98/trip), versus Lyft's 24.1% ($6.16/trip).",
      "zh": "2026-08，Uber 毛额抽成率为 21.8%（每单 $5.98），Lyft 为 24.1%（每单 $6.16）。"
    },
    {
      "id": "growth",
      "en": "From 2019-02 to 2026-08, Uber's mean base fare per trip grew +73.5% and mean driver pay +38.2%; Lyft's fare grew +49.5% and driver pay +65.9%.",
      "zh": "从 2019-02 到 2026-08，Uber 平均每单基础车费增长 +73.5%、司机收入增长 +38.2%；Lyft 车费增长 +49.5%、司机收入增长 +65.9%。"
    },
    {
      "id": "convergence",
      "en": "Gross take rates have moved closer: in 2019-02 Lyft was 31.6% and Uber 1.9% (Uber was -4.6% in 2019-03). Since 2024, both companies' monthly rates have been roughly 19%–28%; in 2026-08, Uber was 21.8% and Lyft 24.1%. Uber's early take was unusually low, so growth comparisons using 2019-02 are sensitive to that starting point.",
      "zh": "两家毛额抽成率在靠拢：2019-02 Lyft 为 31.6%，Uber 为 1.9%（2019-03 Uber 为 -4.6%）；2024 年以来两家月度抽成率都在约 19%–28%，2026-08 Uber 为 21.8%、Lyft 为 24.1%。Uber 在 2019 年初的抽成很低，以 2019-02 为基准的增长对比会受这个起点影响。"
    },
    {
      "id": "share",
      "en": "Over the latest 12 months, Lyft handled 27.8% of Uber/Lyft trips; its mean gross take was $5.92/trip versus Uber's $6.43.",
      "zh": "最近 12 个月，Lyft 占 Uber/Lyft 合计订单的 27.8%；平均每单毛额抽成为 $5.92，Uber 为 $6.43。"
    },
    {
      "id": "short",
      "en": "For Uber trips up to 2 miles in the latest 12 months, gross take rate was 30.4%; driver pay exceeded base fare on 10.0% of trips.",
      "zh": "最近 12 个月，Uber 不超过 2 英里的订单毛额抽成率为 30.4%；10.0% 的订单司机收入高于基础车费。"
    },
    {
      "id": "congestion",
      "en": "In matched Feb-Dec 2025 versus 2024 months, Uber's zone-linked speed changed +2.8%, versus -0.9% elsewhere: a +3.7 percentage-point descriptive gap.",
      "zh": "2025 年与 2024 年匹配的 2—12 月相比，Uber 区内关联订单速度变动 +2.8%，其他订单变动 -0.9%，描述性差距为 +3.7 个百分点。"
    }
  ],
  "memo": [
    {
      "title_en": "Test price changes against driver pay and retention",
      "title_zh": "定价试验同时看司机收入与留存",
      "evidence_en": "From 2019-02 to 2026-08, mean fare/pay grew +73.5%/+38.2% for Uber and +49.5%/+65.9% for Lyft. Gross take rates have moved closer: in 2019-02 Lyft was 31.6% and Uber 1.9% (Uber was -4.6% in 2019-03). Since 2024, both companies' monthly rates have been roughly 19%–28%; in 2026-08, Uber was 21.8% and Lyft 24.1%. Uber's early take was unusually low, so growth comparisons using 2019-02 are sensitive to that starting point.",
      "evidence_zh": "从 2019-02 到 2026-08，Uber 平均每单车费/司机收入增长 +73.5%/+38.2%，Lyft 为 +49.5%/+65.9%。两家毛额抽成率在靠拢：2019-02 Lyft 为 31.6%，Uber 为 1.9%（2019-03 Uber 为 -4.6%）；2024 年以来两家月度抽成率都在约 19%–28%，2026-08 Uber 为 21.8%、Lyft 为 24.1%。Uber 在 2019 年初的抽成很低，以 2019-02 为基准的增长对比会受这个起点影响。",
      "action_en": "Test by zone and hour; track completions, repeat usage and driver supply alongside gross take. This historical gap does not establish pricing power.",
      "action_zh": "按区域与时段做小规模定价试验，同时看完成单量、复购、司机供给和毛额抽成；历史增速差不能直接证明提价空间。"
    },
    {
      "title_en": "Allocate supply by wait time, including airport trips",
      "title_zh": "按等待时间配置运力，单独看机场",
      "evidence_en": "Airport-linked trips were 8.4% of Uber trips in the latest 12 months, with 6.2-minute valid mean waits and 30.9% gross take rate.",
      "evidence_zh": "最近 12 个月，机场关联订单占 Uber 的 8.4%，有效平均等待 6.2 分钟，毛额抽成率 30.9%。",
      "action_en": "Pilot supply incentives where waits persist. Measure completions, driver pay including incentives, and platform contribution after incentives using internal data.",
      "action_zh": "按区域和时段的等待情况试验运力激励；衡量完成率、计入激励后的司机收入，并用内部数据核对扣除激励后的平台贡献。"
    },
    {
      "title_en": "Evaluate short trips in dollars as well as take rates",
      "title_zh": "短途单同时看比例与每单金额",
      "evidence_en": "Uber trips up to 2 miles had a 30.4% gross take rate, but just $3.96/trip versus $6.43 overall; 10.0% paid drivers above base fare.",
      "evidence_zh": "Uber 不超过 2 英里的订单抽成率 30.4%，但每单仅 $3.96，整体为 $6.43；10.0% 的订单司机收入高于基础车费。",
      "action_en": "Prioritize pickup efficiency before broad minimum-fare increases. Test rider retention and driver pay; negative gross take alone does not establish a net loss.",
      "action_zh": "优先缩短接驾，再考虑广泛调高最低车费；测试留存并遵守司机支付要求。负抽成不能直接当作净亏损。"
    },
    {
      "title_en": "Separate the congestion fee from platform pricing",
      "title_zh": "把拥堵费和平台定价分开评估",
      "evidence_en": "Uber zone-linked fare/trip changed +11.0%, pay/trip +7.6%, and take/trip +19.3%. The recorded CBD charge averaged $1.50 per charged trip.",
      "evidence_zh": "Uber 区内关联订单每单车费变动 +11.0%，司机收入 +7.6%，毛额抽成 +19.3%；被收费订单平均记录 CBD 费用 $1.50。",
      "action_en": "Itemize the passenger fee and monitor demand, pay and take separately. Controlled tests are needed to identify economic incidence.",
      "action_zh": "清晰列出乘客附加费，分开监测需求、司机收入与抽成；用对照试验识别经济负担归属。"
    }
  ]
}
